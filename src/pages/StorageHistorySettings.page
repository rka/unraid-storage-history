Menu="Settings:0"
Title="Storage History"
---
<?PHP
require_once '/usr/local/emhttp/plugins/storage-history/include/history.php';
$defaults = sh_config();
$message = '';
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
  $enabled = ($_POST['enabled'] ?? 'no') === 'yes' ? 'yes' : 'no';
  $intervals = ['15min','30min','hourly','6hourly','12hourly','daily'];
  $interval = in_array($_POST['interval'] ?? '', $intervals, true) ? $_POST['interval'] : 'hourly';
  $days = max(30, min(1825, (int)($_POST['retention_days'] ?? 365)));
  $path = trim((string)($_POST['data_path'] ?? '/mnt/user/system/storage-history'));
  if (!str_starts_with($path, '/mnt/')) { $message = 'Data path must be under /mnt.'; }
  else {
    $contents = "enabled=$enabled\ninterval=$interval\nretention_days=$days\ndata_path=$path\n";
    @mkdir(dirname(SH_CONFIG), 0755, true);
    file_put_contents(SH_CONFIG, $contents, LOCK_EX);
    $defaults = sh_config(); $message = 'Settings saved. The schedule is refreshed automatically.';
    @exec('/usr/local/emhttp/plugins/storage-history/scripts/update-cron');
  }
}
?>
<?if ($message):?><div class="notice"><?=htmlspecialchars($message)?></div><?endif;?>
<form method="post" markdown="1">
<label>Enable collection <select name="enabled"><option value="yes" <?=$defaults['enabled']==='yes'?'selected':''?>>Yes</option><option value="no" <?=$defaults['enabled']==='no'?'selected':''?>>No</option></select></label><br>
<label>Interval <select name="interval"><?foreach(['15min'=>'15 minutes','30min'=>'30 minutes','hourly'=>'Hourly','6hourly'=>'Every 6 hours','12hourly'=>'Every 12 hours','daily'=>'Daily'] as $key=>$label):?><option value="<?=$key?>" <?=$defaults['interval']===$key?'selected':''?>><?=$label?></option><?endforeach;?></select></label><br>
<label>Retention (days) <input name="retention_days" type="number" min="30" max="1825" value="<?=htmlspecialchars($defaults['retention_days'])?>"></label><br>
<label>Data path <input name="data_path" size="45" value="<?=htmlspecialchars($defaults['data_path'])?>"></label>
<p>Default storage is on the System share, not the USB boot device.</p>
<input type="submit" value="Apply">
</form>

